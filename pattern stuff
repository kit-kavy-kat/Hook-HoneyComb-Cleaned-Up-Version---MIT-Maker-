import * as THREE from 'three';
import {OrbitControls} from 'three/addons/controls/OrbitControls.js';
import {TYPES,parse,format,validate} from './pattern.js';
import './style.css';
const $=id=>document.getElementById(id);
const examples={basic:'Row 1: sc 12\nRow 2: hdc 12\nRow 3: dc 12\nRow 4: sc 12',stripe:'Row 1: sc 16\nRow 2: sc 4, dc 8, sc 4\nRow 3: hdc 16',mini:'Row 1: sc 6\nRow 2: sc 6\nRow 3: sc 6'};
let rows=parse(examples.basic),selected=null,history=[examples.basic],cursor=0,timer=null,meshes=[],renderer,scene,camera,controls,model,projectId=null;
$('pattern').value=examples.basic;
const notice=(s)=>$('notice').textContent=s;
function record(text){if(history[cursor]!==text){history=history.slice(0,cursor+1);history.push(text);if(history.length>60)history.shift();cursor=history.length-1;}buttons();}
function buttons(){$('undo').disabled=cursor===0;$('redo').disabled=cursor>=history.length-1;}
function stop(){clearInterval(timer);timer=null;$('play').textContent='Play';}
function total(){return rows.reduce((n,r)=>n+r.length,0);}
function snapshot(){return {name:$('name').value||'Untitled swatch',text:format(rows),color:$('color').value,yarn:$('yarn').value};}
function apply(text,keepHistory=true){try{const next=parse(text);stop();rows=next;selected=null;$('pattern').value=text;if(keepHistory)record(text);$('error').textContent='';$('dirty').textContent='Preview is up to date.';$('step').max=total();$('step').value=total();drawGrid();rebuild();return true;}catch(e){$('error').textContent=e.message;return false;}}
function requireApplied(){if($('pattern').value!==format(rows)&&!apply($('pattern').value))return false;return true;}
$('pattern').oninput=()=>{$('dirty').textContent='Unapplied edits — click Visualize.';};
$('apply').onclick=()=>apply($('pattern').value);
$('undo').onclick=()=>{if(cursor>0){cursor--;apply(history[cursor],false);buttons();}};
$('redo').onclick=()=>{if(cursor<history.length-1){cursor++;apply(history[cursor],false);buttons();}};
$('example').onchange=e=>{if(examples[e.target.value]){apply(examples[e.target.value]);e.target.value='';}};
$('addrow').onclick=()=>{if(!requireApplied())return;const n=Number($('count').value);if(!Number.isInteger(n)||n<1||n>40){notice('Choose a whole-number count from 1 to 40.');return;}apply(format([...rows,Array(n).fill($('type').value)]));};
function editSelected(remove){if($('pattern').value!==format(rows)){notice('Visualize pending text edits first, then select a stitch.');return;}if(!selected){notice('Select a stitch in the map first.');return;}const next=rows.map(r=>[...r]);const [r,c]=selected;if(remove){next[r].splice(c,1);if(!next[r].length)next.splice(r,1);}else next[r][c]=$('type').value;if(!next.length){notice('Keep at least one stitch in the project.');return;}apply(format(next));}
$('replace').onclick=()=>editSelected(false);$('remove').onclick=()=>editSelected(true);
function drawGrid(){const grid=$('grid');grid.replaceChildren();for(let r=rows.length-1;r>=0;r--){const line=document.createElement('div');line.className='gridrow';const label=document.createElement('span');label.textContent=`R${r+1}`;line.append(label);rows[r].forEach((type,c)=>{const b=document.createElement('button');b.textContent=type;b.title=`Row ${r+1}, stitch ${c+1}: ${TYPES[type].name}`;b.className=selected?.[0]===r&&selected?.[1]===c?'selected':'';b.onclick=()=>{selected=[r,c];$('type').value=type;$('selection').textContent=`Row ${r+1}, stitch ${c+1} — ${TYPES[type].name}`;$('step').value=rows.slice(0,r).reduce((a,b)=>a+b.length,0)+c+1;stop();drawGrid();updateVisibility();};line.append(b);});grid.append(line);}if(!selected)$('selection').textContent='No stitch selected.';}
function makeGeometry(type,radius){const h=TYPES[type].height;const paths=type==='ch'?[[[-.34,.2,0],[-.2,.38,.04],[.25,.35,0],[.34,.18,.04],[0,.04,.12],[-.34,.2,0]]]:[[[-.28,.05,0],[-.25,h*.5,.08],[-.28,h-.12,0],[0,h,-.12],[.28,h-.12,0],[.25,h*.5,.08],[.28,.05,0]],[[-.4,h-.02,0],[0,h-.2,.2],[.4,h-.02,0]]];const wraps={ch:0,sc:0,hdc:1,dc:2,tr:3}[type];for(let n=0;n<wraps;n++){const y=h*(.3+n*.17);paths.push([[-.25,y,.04],[0,y+.11,.21],[.25,y+.2,.04]]);}return paths.map(p=>new THREE.TubeGeometry(new THREE.CatmullRomCurve3(p.map(a=>new THREE.Vector3(...a))),32,radius,7,false));}
function init3d(){try{scene=new THREE.Scene();scene.background=new THREE.Color('#eee5d8');camera=new THREE.PerspectiveCamera(40,1,.1,100);camera.position.set(0,1,12);renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));$('viewport').append(renderer.domElement);controls=new OrbitControls(camera,renderer.domElement);controls.enableDamping=true;controls.minDistance=3;controls.maxDistance=30;scene.add(new THREE.AmbientLight(0xffffff,1.6));const light=new THREE.DirectionalLight(0xfff5e5,2.8);light.position.set(4,6,8);scene.add(light);const fill=new THREE.DirectionalLight(0xffffff,1);fill.position.set(-4,-1,-3);scene.add(fill);new ResizeObserver(()=>{const w=$('viewport').clientWidth,h=$('viewport').clientHeight;renderer.setSize(w,h);camera.aspect=w/h;camera.updateProjectionMatrix();}).observe($('viewport'));renderer.setAnimationLoop(()=>{controls.update();renderer.render(scene,camera);});}catch(e){renderer=null;$('viewport').textContent='3D could not start. Try a WebGL-enabled browser. The pattern editor, stitch map, and project files still work.';notice('3D unavailable on this device.');}}
function rebuild(){
 if(renderer){if(model){scene.remove(model);const gs=new Set(),ms=new Set();model.traverse(o=>{if(o.isMesh){gs.add(o.geometry);ms.add(o.material);}});gs.forEach(g=>g.dispose());ms.forEach(m=>m.dispose());}model=new THREE.Group();meshes=[];const radius={fine:.042,medium:.068,chunky:.099}[$('yarn').value];const geos=Object.fromEntries(Object.keys(TYPES).map(t=>[t,makeGeometry(t,radius)]));let y=0;rows.forEach((row,r)=>{row.forEach((type,c)=>{const group=new THREE.Group();group.position.set((c-(row.length-1)/2)*.83,y,r%2?.02:-.02);const material=new THREE.MeshStandardMaterial({color:$('color').value,roughness:.9});geos[type].forEach(g=>group.add(new THREE.Mesh(g,material)));group.userData={r,c};model.add(group);meshes.push(group);});y+=Math.max(...row.map(t=>TYPES[t].height))-.05;});const scale=7.5/Math.max(y,Math.max(...rows.map(r=>r.length))*.83,5);model.position.y=-y*scale/2;model.scale.setScalar(scale);scene.add(model); // Dispose unused cached geometries too.
 Object.entries(geos).forEach(([type,list])=>{if(!rows.some(r=>r.includes(type)))list.forEach(g=>g.dispose());});}
 $('stats').textContent=`${rows.length} rows · ${total()} stitches`;updateVisibility();
}
function updateVisibility(){const n=Number($('step').value);meshes.forEach((g,i)=>{g.visible=i<n;const chosen=selected&&g.userData.r===selected[0]&&g.userData.c===selected[1];g.children.forEach(m=>{m.material.emissive.set(chosen?'#704121':'#000000');m.material.emissiveIntensity=.45;});});$('stepLabel').textContent=`${n} / ${total()}`;let k=0,description='Start of pattern.';rows.forEach((row,r)=>row.forEach((type,c)=>{k++;if(k===n)description=`Row ${r+1}, stitch ${c+1}: ${TYPES[type].name} (${type}).`;}));$('instruction').textContent=description;}
$('step').oninput=()=>{stop();updateVisibility();};
function advance(delta){$('step').value=Math.max(0,Math.min(total(),Number($('step').value)+delta));updateVisibility();}
$('back').onclick=()=>{stop();advance(-1);};$('next').onclick=()=>{stop();advance(1);};$('all').onclick=()=>{stop();$('step').value=total();updateVisibility();};
$('play').onclick=()=>{if(timer){stop();return;}if(Number($('step').value)>=total())$('step').value=0;$('play').textContent='Pause';updateVisibility();timer=setInterval(()=>{advance(1);if(Number($('step').value)>=total())stop();},450);};
$('color').oninput=rebuild;$('yarn').onchange=rebuild;
for(const color of ['#c58a66','#e7b655','#8eaa95','#c28b9c','#8d9fb8','#e9ddc3']){const b=document.createElement('button');b.style.background=color;b.title=`Choose ${color}`;b.setAttribute('aria-label',`Yarn color ${color}`);b.onclick=()=>{$('color').value=color;rebuild();};$('swatches').append(b);}
$('front').onclick=()=>{if(camera){camera.position.set(0,0,12);controls.target.set(0,0,0);controls.update();}};
$('reset').onclick=()=>{if(camera){camera.position.set(0,1,12);controls.target.set(0,0,0);controls.update();}};
function readLibrary(){try{const list=JSON.parse(localStorage.getItem('hhc-projects')||'[]');return Array.isArray(list)?list.filter(p=>p&&typeof p.id==='string'&&typeof p.name==='string'):[];}catch{return [];}}
function saveLibrary(list){try{localStorage.setItem('hhc-projects',JSON.stringify(list));return true;}catch{notice('Browser storage is unavailable or full. Export JSON to keep your project.');return false;}}
function library(){const box=$('projects');box.replaceChildren();const list=readLibrary();if(!list.length)box.textContent='No saved projects yet.';list.forEach(p=>{const line=document.createElement('div');line.className='saved';const open=document.createElement('button');open.textContent=p.name;open.onclick=()=>{if(!confirm('Open this project? Export or save any changes you want to keep.'))return;try{load(validate(p));projectId=p.id;notice('Project opened.');}catch(e){notice(e.message);}};const del=document.createElement('button');del.textContent='Delete';del.onclick=()=>{if(confirm(`Delete “${p.name}” from this browser?`)){if(saveLibrary(readLibrary().filter(x=>x.id!==p.id))){if(projectId===p.id)projectId=null;library();}}};line.append(open,del);box.append(line);});}
function load(data){$('name').value=data.name;$('color').value=data.color;$('yarn').value=data.yarn;history=[data.text];cursor=0;apply(data.text,false);buttons();}
$('save').onclick=()=>{if(!requireApplied())return;const list=readLibrary(),id=projectId||crypto.randomUUID(),p={...snapshot(),id,updated:new Date().toISOString()};const i=list.findIndex(x=>x.id===id);if(i<0)list.push(p);else list[i]=p;if(saveLibrary(list)){projectId=id;library();notice('Saved in this browser. Export JSON for a portable backup.');}};
$('new').onclick=()=>{if(confirm('Start a new project? Save or export changes first.')){projectId=null;load({name:'Untitled swatch',text:'Row 1: sc 12',color:'#c58a66',yarn:'medium'});notice('New project started.');}};
function download(blob,name){const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),2000);}
const filename=()=>($('name').value.replace(/[^a-z0-9_-]/gi,'-').slice(0,60)||'swatch');
$('export').onclick=()=>{if(requireApplied())download(new Blob([JSON.stringify({format:'hook-honeycomb',version:1,...snapshot()},null,2)],{type:'application/json'}),filename()+'.json');};
$('import').onclick=()=>$('file').click();$('file').onchange=async e=>{const f=e.target.files[0];try{if(!f)return;if(f.size>100000)throw Error('Project file is too large (100 KB limit).');const data=validate(JSON.parse(await f.text()));if(!confirm('Replace the current project? Save or export existing changes first.'))return;load(data);projectId=null;notice('Project imported.');}catch(err){notice('Import failed: '+err.message);}finally{e.target.value='';}};
$('png').onclick=()=>{if(!renderer){notice('3D is unavailable; cannot export a picture.');return;}renderer.render(scene,camera);renderer.domElement.toBlob(blob=>{if(blob)download(blob,filename()+'.png');else notice('Picture export failed.');});};
$('help').onclick=()=>$('helpDialog').showModal();$('closeHelp').onclick=()=>$('helpDialog').close();
window.addEventListener('beforeunload',e=>{const current=snapshot();const saved=readLibrary().find(p=>p.id===projectId);if($('pattern').value!==format(rows)||!saved||['name','text','color','yarn'].some(k=>saved[k]!==current[k])){e.preventDefault();e.returnValue='';}});
init3d();apply(examples.basic);library();
